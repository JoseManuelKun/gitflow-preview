flowchart LR
    F["feature/*"] -->|validate| P["preview"]
    F -->|accept| D["development"]
    D -->|release| M["master"]
    H["hotfix/*"] -->|production fix| M
    H -->|sync fix| D
    H -->|sync fix| P
    P -. "MUST NOT merge" .-> D

    classDef source fill:#eef7ff,stroke:#1b6ca8,color:#0f2f44
    classDef validation fill:#fff7e6,stroke:#bd7b00,color:#4a2e00
    classDef work fill:#f2f2f2,stroke:#666,color:#222
    classDef forbidden fill:#ffecec,stroke:#c62828,color:#7a1111,stroke-dasharray: 5 5

    class M,D source
    class P validation
    class F,H work
