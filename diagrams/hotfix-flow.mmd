flowchart TD
    M["master"] -->|branch| H["hotfix/*"]
    H -->|merge urgent fix| M
    H -->|merge fix forward| D["development"]
    H -->|merge fix to validation| P["preview"]
    M -->|tag release| T["vX.Y.Z"]

    classDef production fill:#eef7ff,stroke:#1b6ca8,color:#0f2f44
    classDef validation fill:#fff7e6,stroke:#bd7b00,color:#4a2e00
    classDef work fill:#f2f2f2,stroke:#666,color:#222
    classDef tag fill:#edf7ed,stroke:#2e7d32,color:#143d17

    class M,D production
    class P validation
    class H work
    class T tag
