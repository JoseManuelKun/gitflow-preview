%%{init: { "theme": "base", "themeVariables": { "actorBkg": "#53c98f", "actorBorder": "#333333", "actorTextColor": "#111111", "signalColor": "#333333", "signalTextColor": "#111111", "noteBkgColor": "#ffffff", "noteTextColor": "#111111" } }}%%
sequenceDiagram
    autonumber
    box rgb(185, 144, 232) development
        participant Development as development
    end
    box rgb(83, 201, 143) feature/*
        participant Feature as feature/*
    end
    box rgb(97, 216, 209) preview
        participant Preview as preview
    end

    Development->>Feature: branch feature
    Feature->>Preview: merge for validation
    Preview-->>Preview: deploy preview build
    Preview-->>Feature: QA/client feedback
    Feature->>Feature: apply requested changes
    Feature->>Preview: merge updated feature for validation
    Feature->>Development: merge accepted feature
    Note over Preview,Development: preview MUST NOT merge into development.
