%%{init: { "theme": "base", "themeVariables": { "actorBkg": "#f1745f", "actorBorder": "#333333", "actorTextColor": "#111111", "signalColor": "#333333", "signalTextColor": "#111111", "noteBkgColor": "#ffffff", "noteTextColor": "#111111" } }}%%
sequenceDiagram
    autonumber
    box rgb(185, 227, 249) master
        participant Master as master
    end
    box rgb(241, 116, 95) hotfix/*
        participant Hotfix as hotfix/*
    end
    box rgb(97, 216, 209) preview
        participant Preview as preview
    end
    box rgb(185, 144, 232) development
        participant Development as development
    end

    Master->>Hotfix: branch urgent fix
    Hotfix->>Preview: merge for validation
    Preview-->>Preview: deploy hotfix preview build
    Preview-->>Hotfix: validation result
    Hotfix->>Development: merge validated hotfix
    Hotfix->>Master: merge production hotfix
    Master-->>Master: tag production release
    Note over Hotfix,Master: Critical incidents MAY release to master first.
